<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.vant.chat">

    <!-- Required so incoming-call notifications can launch the full-screen
         call UI over the lock screen (granted automatically for call apps).
         Without this, background activity starts are silently blocked and the
         user only sees a heads-up notification. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Required for dismissing keyguard to show call UI over lock screen -->
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
    <!-- Permissions for biometric authentication -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <uses-permission android:name="android.permission.USE_FINGERPRINT"/>
    <!-- Internet permission for socket connections -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- FCM notification permissions -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Battery optimization exemption for Samsung devices -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- App icon badge permissions for various launchers -->
    <uses-permission android:name="com.sec.android.provider.badge.permission.READ" />
    <uses-permission android:name="com.sec.android.provider.badge.permission.WRITE" />
    <uses-permission android:name="com.htc.launcher.permission.READ_SETTINGS" />
    <uses-permission android:name="com.htc.launcher.permission.UPDATE_SHORTCUT" />
    <uses-permission android:name="com.sonyericsson.home.permission.BROADCAST_BADGE" />
    <uses-permission android:name="com.sonymobile.home.permission.PROVIDER_INSERT_BADGE" />
    <uses-permission android:name="com.anddoes.launcher.permission.UPDATE_COUNT" />
    <uses-permission android:name="com.majeur.launcher.permission.UPDATE_BADGE" />
    <uses-permission android:name="com.huawei.android.launcher.permission.CHANGE_BADGE" />
    <uses-permission android:name="com.huawei.android.launcher.permission.READ_SETTINGS" />
    <uses-permission android:name="com.huawei.android.launcher.permission.WRITE_SETTINGS" />

    <!-- Audio/video call permissions -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Gallery/photo permissions for Android 13+ -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Gallery permissions for older Android versions -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- We only open photos/documents/PDFs, never video or audio files.
         The open_filex plugin declares these unconditionally in its own
         manifest; remove them since the app doesn't need video/audio access. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove" />
    <!-- Foreground service to keep call alive when app is backgrounded -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SHORT_SERVICE" />
    <!-- Self-managed ConnectionService: allows full-screen incoming call UI over lock screen -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <!-- Proximity sensor wake lock for screen off during calls -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <application
        android:label="@string/app_name"
        android:name=".MainApplication"
        android:icon="@mipmap/launcher_icon"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
       
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            
          


            <!-- Custom scheme for direct app opening -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vantchat" />
            </intent-filter>

            <!-- Custom scheme with specific host -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vantchat" android:host="chat" />
            </intent-filter>

            <!-- Custom scheme for opening -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vantchat" android:host="open" />
            </intent-filter>

            <!-- Branch.io deep links - Without autoVerify for immediate opening -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                
                <data android:scheme="https" />
                <data android:host="vantchatting.app.link" />
            </intent-filter>

            <!-- Branch.io deep links - Alternate -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                
                <data android:scheme="https" />
                <data android:host="vantchatting-alternate.app.link" />
            </intent-filter>

            <!-- Branch.io deep links - With path -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                
                <data android:scheme="https" />
                <data android:host="vantchatting.app.link" />
                <data android:path="/" />
            </intent-filter>

            <!-- Branch.io deep links - Alternate with path -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                
                <data android:scheme="https" />
                <data android:host="vantchatting-alternate.app.link" />
                <data android:path="/" />
            </intent-filter>

            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Call foreground service - keeps WebRTC alive when app is backgrounded -->
        <service
            android:name="id.flutter.flutter_background_service.BackgroundService"
            android:foregroundServiceType="microphone"
            android:exported="false"
            tools:replace="android:exported" />

        <!-- flutter_local_notifications foreground service for ongoing call notification -->
        <service
            android:name="com.dexterous.flutterlocalnotifications.ForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Disable the library's BootReceiver - starting a microphone foreground
             service from BOOT_COMPLETED is illegal on Android 12+ and causes a
             ForegroundServiceStartNotAllowedException crash. The service is only
             started when an actual call begins (user-initiated). -->
        <receiver
            android:name="id.flutter.flutter_background_service.BootReceiver"
            android:enabled="false"
            tools:replace="android:enabled" />

        <!-- Disable the library's WatchdogReceiver - it periodically tries to
             respawn the service from background alarms, which also violates
             Android 12+ foreground service restrictions for microphone type. -->
        <receiver
            android:name="id.flutter.flutter_background_service.WatchdogReceiver"
            android:enabled="false"
            tools:replace="android:enabled" />

        <!-- Custom FCM service that handles incoming calls natively when the app is killed -->
        <service
            android:name=".VantFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Remove the plugin's FCM service from the merged manifest: BOTH it and
             VantFirebaseMessagingService receive every MESSAGING_EVENT, so each push
             reached the Dart background handler twice — duplicated message
             notifications when the app is killed. Plugin initialization does not
             need this service (FlutterFirebaseMessagingInitProvider stays).
             Ours handles calls natively and forwards everything else manually. -->
        <service
            android:name="io.flutter.plugins.firebase.messaging.FlutterFirebaseMessagingService"
            android:exported="false"
            tools:node="remove" />

        <!-- Incoming call full-screen activity shown over the lock screen -->
        <activity
            android:name=".IncomingCallActivity"
            android:exported="false"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:theme="@style/IncomingCallTheme" />

        <!-- Self-managed ConnectionService for VoIP calls (like WhatsApp/Telegram).
             Registers with Android Telecom to guarantee full-screen intent over lock screen. -->
        <service
            android:name=".VantConnectionService"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>

        <!-- Incoming Call Foreground Service - ringing only (no microphone/phoneCall needed)
             Uses shortService type on Android 14+: no special permissions, can start from background,
             runs up to ~3 min which is plenty for ringing. Microphone FGS is only needed when
             the call is actually answered (handled by flutter_background_service). -->
        <service
            android:name=".CallForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="shortService|microphone|camera|phoneCall" />

        <!-- Boot receiver for Samsung devices to restart services after device restart -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Firebase notification configuration -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="high_importance_channel" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/colorAccent" />

        <!-- Branch SDK Configuration -->
        <meta-data 
            android:name="io.branch.sdk.BranchKey" 
            android:value="key_live_duxqKkJhod2Xdn2FEQ0Aujgjvxhu3F0E" />

        <!-- Google Pay integration -->
        <meta-data
            android:name="com.google.android.gms.wallet.api.enabled"
            android:value="true" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <!-- Required for url_launcher to work on Android 11+ -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
    </queries>
</manifest>
