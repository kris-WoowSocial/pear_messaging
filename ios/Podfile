# Uncomment this line to define a global platform for your project
platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    target.build_configurations.each do |config|
      # Set iOS deployment target to 15.5 (required by mobile_scanner 6.0.11)
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'
      
      # Enable modular headers for all targets
      config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
      config.build_settings['DEFINES_MODULE'] = 'YES'
      
      # Allow non-modular includes in framework modules
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      
      # Disable bitcode (deprecated in Xcode 14)
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      
      # Exclude PassKit framework since we don't use Apple Pay
      config.build_settings['EXCLUDED_FRAMEWORKS'] = ['PassKit.framework']

      # permission_handler compile-time macros.
      # Without these, permission_handler strips the permission code at build
      # time and returns permanentlyDenied instantly (no iOS dialog is shown).
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] += [
        ## dart: PermissionGroup.microphone
        'PERMISSION_MICROPHONE=1',
        ## dart: PermissionGroup.notification
        'PERMISSION_NOTIFICATIONS=1',
        ## dart: PermissionGroup.camera
        'PERMISSION_CAMERA=1',
        ## dart: PermissionGroup.photos
        'PERMISSION_PHOTOS=1',
      ]
      
      # Fix Info.plist generation conflict for NotificationService
      if target.name == 'NotificationService'
        config.build_settings['GENERATE_INFOPLIST_FILE'] = 'NO'
      end
      
      # Additional Firebase-specific settings
      if target.name.start_with?('Firebase') || target.name.include?('firebase')
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'FIREBASE_VERSION=10.25.0'
        config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
        config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      end
    end
  end

  plugin_source = File.join(__dir__, '.symlinks', 'plugins', 'flutter_webrtc', 'ios', 'Classes', 'FlutterWebRTCPlugin.m')
  if File.exist?(plugin_source)
    source = File.read(plugin_source)
    original = <<~OBJC
      void postEvent(FlutterEventSink _Nonnull sink, id _Nullable event) {
          dispatch_async(dispatch_get_main_queue(), ^{
            sink(event);
          });
      }
    OBJC
    replacement = <<~OBJC
      void postEvent(FlutterEventSink _Nullable sink, id _Nullable event) {
          if (sink == nil) {
            return;
          }
          dispatch_async(dispatch_get_main_queue(), ^{
            if (sink != nil) {
              sink(event);
            }
          });
      }
    OBJC
    File.write(plugin_source, source.sub(original, replacement)) if source.include?(original)
  end
end
