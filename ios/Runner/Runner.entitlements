<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.voip</key>
	<true/>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:vantchatting.app.link</string>
		<string>applinks:vantchatting-alternate.app.link</string>
	</array>
	<key>com.apple.developer.in-app-payments</key>
	<array>
		<string>merchant.com.vant.chatting</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.vant.chatting</string>
	</array>
</dict>
</plist>
